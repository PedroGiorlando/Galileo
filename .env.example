# Copiá este archivo como .env.local y completá con los valores de tu proyecto.
# .env.local esta ignorado por git: las claves reales nunca se commitean.
#
# Donde salen: Supabase -> Project Settings -> API

# Publica: viaja al navegador. No es secreta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta: saltea RLS. Solo se usa del lado del servidor (webhook de pagos,
# scripts de migracion). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# La direccion publica del sitio. La usan tres cosas:
#   - a donde vuelve el link de confirmacion del correo
#   - el <link rel="canonical"> de cada pagina
#   - og:url y og:image, que NO admiten direcciones relativas
#
# EN VERCEL TIENE QUE SER EL DOMINIO REAL. Si queda en localhost, el sitio
# publicado le dice a Google y a WhatsApp que su contenido vive en la
# computadora de quien lo mira: no hay imagen al compartir y los canonical
# apuntan a ninguna parte. No da error en el build ni en el navegador.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Poner en true recien cuando haya contenido suficiente para indexar.
#
# Con false, robots.txt prohibe todo, cada pagina pide noindex y el sitemap
# sale vacio: las tres cosas de acuerdo. Un sitio con tres clases indexado como
# si estuviera terminado es contenido pobre, y eso castiga al dominio entero.
NEXT_PUBLIC_INDEXABLE=false
